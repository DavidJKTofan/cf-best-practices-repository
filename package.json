{
	"name": "cf-best-practices-repository",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:local": "wrangler d1 execute DB --local --file=./initial_data.sql",
		"db:seed:refresh": "wrangler d1 export DB --remote --no-schema --table Categories --table CloudflareFeatures --table BestPractices --output=./initial_data.sql"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.3.6",
		"vitest": "^4.1.11",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"jose": "^6.2.12"
	}
}
